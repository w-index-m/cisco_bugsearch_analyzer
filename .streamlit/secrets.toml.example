# Streamlit Cloud での設定方法:
#   1. アプリの管理画面 → Settings → Secrets を開く
#   2. このファイルの中身をコピーして貼り付け、実際のAPIキーに置き換える
#   3. Save すると、次回アプリ起動時から自動で読み込まれます
#
# ローカルで試す場合は、このファイルを同じ .streamlit/ フォルダ内に
# secrets.toml という名前でコピーして使ってください（Git管理対象外）。
#
# 全部任意項目です。設定しなかったキーは、アプリ画面で手入力してください。

DEEPL_API_KEY = "your-deepl-api-key"
NVIDIA_API_KEY = "your-nvidia-api-key"
GROQ_API_KEY = "your-groq-api-key"
GEMINI_API_KEY = "your-gemini-api-key"
OPENROUTER_API_KEY = "your-openrouter-api-key"
NVD_API_KEY = "your-nvd-api-key"
